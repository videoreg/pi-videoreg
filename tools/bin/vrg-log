#!/bin/bash
# Shows the journalctl log of a videoreg service, optionally filtered by plugin.
# Usage: vrg-log NAME [LINES] [-f]

set -e  # Stop execution on error

# Output colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

show_usage() {
    echo "Usage: vrg-log NAME [LINES] [-f]"
    echo ""
    echo "Parameters:"
    echo "  NAME   Plugin name (power), plugin id (org_vrg_power)"
    echo "         or service name (vrg-core) — required"
    echo "  LINES  Number of lines to show (optional, default: 300)"
    echo "  -f     Follow the log (optional)"
    echo ""
    echo "A plugin name shows its own service journal filtered by the plugin tag;"
    echo "a service name shows the whole service journal."
    echo ""
    echo "Examples:"
    echo "  vrg-log power"
    echo "  vrg-log power 500"
    echo "  vrg-log vrg-core 1000 -f"
}

check_project_home() {
    if [[ -z "$VIDEOREG_PROJECT_HOME" ]]; then
        print_error "VIDEOREG_PROJECT_HOME environment variable is not set"
        print_error "Set it with: source tools/init.sh"
        exit 1
    fi

    if [[ ! -d "$VIDEOREG_PROJECT_HOME" ]]; then
        print_error "Project directory does not exist: $VIDEOREG_PROJECT_HOME"
        exit 1
    fi
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_usage
    exit 0
fi

if [[ -z "$1" ]]; then
    print_error "NAME is required"
    echo ""
    show_usage
    exit 1
fi

NAME="$1"
shift

LINES=300
FOLLOW=""

for arg in "$@"; do
    case "$arg" in
        -f|--follow) FOLLOW="-f" ;;
        ''|*[!0-9]*)
            print_error "Unknown argument: $arg"
            echo ""
            show_usage
            exit 1
            ;;
        *) LINES="$arg" ;;
    esac
done

check_project_home

PYTHON="$VIDEOREG_PROJECT_HOME/.venv/bin/python3"
if [[ ! -x "$PYTHON" ]]; then
    PYTHON="python3"
fi

# Resolve NAME into a systemd service and (for a plugin) its log tag.
RESOLVED=$("$PYTHON" - "$VIDEOREG_PROJECT_HOME" "$NAME" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])

from sdk.videoreg import load_manifest  # noqa: E402

project_home, name = Path(sys.argv[1]), sys.argv[2]
manifest = load_manifest(project_home)

services = {s["name"]: s.get("plugins") or [] for s in manifest.services}
plugins = {p["id"]: p.get("name", p["id"]) for p in manifest.plugins}

# Plugin id or plugin short name — checked first, so `core` means the plugin
# and `vrg-core` means the whole service
plugin_id = None
if name in plugins:
    plugin_id = name
else:
    for pid, pname in plugins.items():
        if pname == name:
            plugin_id = pid
            break

if plugin_id:
    for service_name, service_plugins in services.items():
        if plugin_id in service_plugins:
            print(f"{service_name}\t{plugins[plugin_id]}")
            sys.exit(0)
    print(f"plugin {plugin_id} is not attached to any service", file=sys.stderr)
    sys.exit(1)

# Service name, with or without the vrg- prefix
for candidate in (name, f"vrg-{name}"):
    if candidate in services:
        print(f"{candidate}\t")
        sys.exit(0)

print(f"unknown plugin or service: {name}", file=sys.stderr)
sys.exit(1)
PY
) || {
    print_error "Failed to resolve '$NAME'"
    exit 1
}

SERVICE="${RESOLVED%%$'\t'*}"
PLUGIN_TAG="${RESOLVED#*$'\t'}"

if [[ -n "$PLUGIN_TAG" ]]; then
    print_info "Service: $SERVICE (plugin: $PLUGIN_TAG)"
else
    print_info "Service: $SERVICE"
fi
print_info "Lines: $LINES"
echo ""

if [[ -z "$PLUGIN_TAG" ]]; then
    journalctl -u "$SERVICE.service" -n "$LINES" --no-pager $FOLLOW
    exit 0
fi

# Plugin lines are tagged with the plugin short name by sdk/log.py.
# Scan a wider window so the filtered output still yields up to LINES rows.
if [[ -n "$FOLLOW" ]]; then
    journalctl -u "$SERVICE.service" -n "$LINES" --no-pager -f \
        | grep -F --line-buffered ":$PLUGIN_TAG: "
else
    journalctl -u "$SERVICE.service" -n $((LINES * 20)) --no-pager \
        | grep -F ":$PLUGIN_TAG: " \
        | tail -n "$LINES"
fi
